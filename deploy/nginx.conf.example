# External Nginx http{} include; replace the reserved example name and certificate paths.
# The app's port stays bound to localhost. No ACME/DNS/public deployment is performed here.
server {
    listen 80;
    server_name seekbell.example.test;
    return 308 https://seekbell.example.test$request_uri;
}
server {
    listen 443 ssl;
    server_name seekbell.example.test;
    ssl_certificate /etc/nginx/tls/seekbell.crt;
    ssl_certificate_key /etc/nginx/tls/seekbell.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log stderr crit;
    client_max_body_size 2049m;
    client_body_timeout 300s;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        # Preserve the public authority INCLUDING a non-default port for CSRF.
        proxy_set_header Host $http_host;
        # This is a single edge: overwrite client-supplied forwarding chains.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 300s;
        proxy_read_timeout 600s;
    }
}
