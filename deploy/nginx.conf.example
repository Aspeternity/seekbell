# Inside an existing HTTPS server block; TLS termination is managed externally.
# Preserve Host and replace client-supplied proxy headers.
location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
}
# Set SEEKBELL_TRUSTED_PROXIES to the actual peer IP/CIDR seen by the application.
# Host gateway/rootless mappings can change that peer; verify Secure cookies in M5.
