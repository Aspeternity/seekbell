{
  "name": "seekbell-frontend",
  "private": true,
  "version": "0.1.0-dev.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "dev:prototype": "vite --config vite.prototype.config.ts",
    "build:prototype": "pnpm typecheck && vite build --config vite.prototype.config.ts",
    "preview:prototype": "vite preview --config vite.prototype.config.ts --host 127.0.0.1 --port 5174",
    "test:prototype": "playwright test",
    "serve:prototype": "node serve-prototype.mjs",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:history": "playwright test --config playwright.history.config.ts",
    "test:sending": "playwright test --config playwright.sending.config.ts",
    "test:runtime": "playwright test --config playwright.runtime.config.ts",
    "test:operations": "playwright test --config playwright.operations.config.ts",
    "test:retention": "playwright test --config playwright.retention.config.ts"
  },
  "dependencies": {
    "naive-ui": "2.45.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.8.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
