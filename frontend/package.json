{
  "name": "seekbell-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:history": "playwright test --config playwright.history.config.ts",
    "test:sending": "playwright test --config playwright.sending.config.ts",
    "test:runtime": "playwright test --config playwright.runtime.config.ts",
    "test:operations": "playwright test --config playwright.operations.config.ts",
    "test:retention": "playwright test --config playwright.retention.config.ts",
    "test:system": "playwright test --config playwright.system.config.ts",
    "test:backup": "playwright test --config playwright.backup.config.ts",
    "test:proxy": "playwright test --config playwright.proxy.config.ts",
    "test:approved-ui": "playwright test --config playwright.approved-ui.config.ts",
    "test:loading": "playwright test --config playwright.loading.config.ts",
    "test:history-ui-fixes": "playwright test --config playwright.history-ui-fixes.config.ts",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:content-stability": "playwright test --config playwright.content-stability.config.ts",
    "test:workspace-stability": "playwright test --config playwright.workspace-stability.config.ts",
    "test:first-entry": "playwright test --config playwright.first-entry.config.ts",
    "test:hotlist": "playwright test --config playwright.hotlist.config.ts",
    "test:evaluations": "playwright test --config playwright.evaluations.config.ts",
    "test:linuxdo": "playwright test --config playwright.linuxdo.config.ts",
    "test:diagnostics": "playwright test --config playwright.diagnostics.config.ts"
  },
  "dependencies": {
    "naive-ui": "2.45.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.8.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
